{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Editorial operations dashboard that prioritizes exceptions, recovery, and next actions while preserving the public-safe Hermes telemetry boundary.",
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.933,
          0.945,
          0.925
        ],
        "hex": "#eef1ec"
      }
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.075,
          0.125,
          0.11
        ],
        "hex": "#13201c"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.722,
          0.239,
          0.161
        ],
        "hex": "#b83d29"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.098,
          0.392,
          0.282
        ],
        "hex": "#196448"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.992,
          0.969
        ],
        "hex": "#fffdf7"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.275,
          0.318,
          0.298
        ],
        "hex": "#46514c"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.757,
          0.78,
          0.753
        ],
        "hex": "#c1c7c0"
      }
    },
    "warm": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.918,
          0.824,
          0.706
        ],
        "hex": "#ead2b4"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "xs": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 38,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "subtle": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Avenir Next, Pretendard Variable, Apple SD Gothic Neo, system-ui, sans-serif",
        "fontSize": {
          "value": 9,
          "unit": "rem"
        },
        "fontWeight": 900,
        "letterSpacing": {
          "value": -0.08,
          "unit": "em"
        },
        "lineHeight": 0.72
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Avenir Next, Apple SD Gothic Neo, system-ui, sans-serif",
        "fontSize": {
          "value": 2.5,
          "unit": "rem"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.05,
          "unit": "em"
        },
        "lineHeight": 1
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Avenir Next, Apple SD Gothic Neo, system-ui, sans-serif",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 450,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        },
        "lineHeight": 1.55
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "SF Mono, ui-monospace, monospace",
        "fontSize": {
          "value": 0.6875,
          "unit": "rem"
        },
        "fontWeight": 750,
        "letterSpacing": {
          "value": 0.13,
          "unit": "em"
        },
        "lineHeight": 1.2
      }
    }
  }
}
